-- CoinSpin: 54x54 sprite sheet, 8 frames. Generated by roblox-2d-art.
-- Upload the PNG, put its id in Sheet.image, then Sheet.apply(imageLabel, "frameName" or index) or Sheet.play(imageLabel).
local RunService = game:GetService("RunService")

local CoinSpin = {
	image = "rbxassetid://0", -- replace with the uploaded image id
	size = Vector2.new(54, 54),
	fps = 12,
	frames = {
		["CoinSpin_1"] = { offset = Vector2.new(1, 1), size = Vector2.new(16, 16) },
		["CoinSpin_2"] = { offset = Vector2.new(19, 1), size = Vector2.new(16, 16) },
		["CoinSpin_3"] = { offset = Vector2.new(37, 1), size = Vector2.new(16, 16) },
		["CoinSpin_4"] = { offset = Vector2.new(1, 19), size = Vector2.new(16, 16) },
		["CoinSpin_5"] = { offset = Vector2.new(19, 19), size = Vector2.new(16, 16) },
		["CoinSpin_6"] = { offset = Vector2.new(37, 19), size = Vector2.new(16, 16) },
		["CoinSpin_7"] = { offset = Vector2.new(1, 37), size = Vector2.new(16, 16) },
		["CoinSpin_8"] = { offset = Vector2.new(19, 37), size = Vector2.new(16, 16) },
	},
	order = { "CoinSpin_1", "CoinSpin_2", "CoinSpin_3", "CoinSpin_4", "CoinSpin_5", "CoinSpin_6", "CoinSpin_7", "CoinSpin_8" },
}

function CoinSpin.apply(label: ImageLabel | ImageButton, frame: string | number)
	local f = if type(frame) == "number" then CoinSpin.frames[CoinSpin.order[frame]] else CoinSpin.frames[frame]
	label.Image = CoinSpin.image
	label.ImageRectOffset = f.offset
	label.ImageRectSize = f.size
end

-- Loops through `order` until the returned stop() is called (or the label is destroyed).
function CoinSpin.play(label: ImageLabel | ImageButton, fps: number?)
	local t, i, step = 0, 1, 1 / (fps or CoinSpin.fps)
	CoinSpin.apply(label, 1)
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not label.Parent then conn:Disconnect() return end
		t += dt
		while t >= step do
			t -= step
			i = i % #CoinSpin.order + 1
			CoinSpin.apply(label, i)
		end
	end)
	return function() conn:Disconnect() end
end

return CoinSpin
