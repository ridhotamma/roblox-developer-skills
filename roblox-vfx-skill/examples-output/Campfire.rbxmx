<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="ModuleScript" referent="RBX1">
		<Properties>
			<string name="Name">Campfire</string>
			<ProtectedString name="Source"><![CDATA[-- Campfire: generated by the roblox-vfx skill. Looping effect.
--   local Campfire = require(path.to.Campfire)
--   local fx = Campfire.play(target, options)   -- target: CFrame | Vector3 | BasePart | Attachment | Model
--   fx:Stop()                                    -- stop early (always needed for loops)
-- options: parent (Instance, default workspace), follow (false = do not weld to a part target),
--          offset (CFrame applied after the target), onMarker (function(name, model))
local RunService = game:GetService("RunService")
local TEMPLATE = script:WaitForChild("Template")
local DURATION, TAIL, LOOP, MAX_LIFE = 1.6, 1.6, true, 2.7414
local BURSTS = {} -- layer, seconds, particle count
local WINDOWS = {
	{"Smoke", 0, 1.6},
	{"FlameBase", 0, 1.6},
	{"FlameCore", 0, 1.6},
	{"Embers", 0, 1.6},
	{"FireLight", 0, 1.6},
} -- layer, on at, off at
local TRACKS = {
	{"FireLight", "Brightness", {{0, 2.2}, {0.21, 2.9}, {0.37, 2}, {0.62, 2.7}, {0.8, 1.9}, {1.1, 3}, {1.33, 2.1}, {1.6, 2.2}}},
} -- layer, property, {seconds, value} keys
local MARKERS = {} -- seconds, name

local VFX = { Name = "Campfire", Duration = DURATION, Tail = TAIL, Loop = LOOP, Template = TEMPLATE }

local function valueAt(keys, t)
	if t <= keys[1][1] then return keys[1][2] end
	for i = 2, #keys do
		local a, b = keys[i - 1], keys[i]
		if t <= b[1] then return a[2] + (b[2] - a[2]) * (t - a[1]) / math.max(b[1] - a[1], 1e-6) end
	end
	return keys[#keys][2]
end

function VFX.play(target, options)
	options = options or {}
	local cf, weldTo
	if typeof(target) == "CFrame" then cf = target
	elseif typeof(target) == "Vector3" then cf = CFrame.new(target)
	elseif typeof(target) == "Instance" and target:IsA("Attachment") then cf, weldTo = target.WorldCFrame, target.Parent
	elseif typeof(target) == "Instance" and target:IsA("BasePart") then cf, weldTo = target.CFrame, target
	elseif typeof(target) == "Instance" and target:IsA("Model") then
		weldTo = target.PrimaryPart
		cf = weldTo and weldTo.CFrame or target:GetPivot()
	else error("VFX.play: target must be a CFrame, Vector3, BasePart, Attachment or Model", 2) end
	if options.offset then cf = cf * options.offset end

	local model = TEMPLATE:Clone()
	model.Name = VFX.Name
	model:PivotTo(cf)
	if weldTo and options.follow ~= false then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = p, weldTo, p
				p.Anchored = false
			end
		end
	end
	local objects = {}
	for _, d in model:GetDescendants() do
		if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Light") then objects[d.Name] = d end
	end
	model.Parent = options.parent or workspace

	local alive, started, threads, conn = true, os.clock(), {}, nil
	local function at(t, fn)
		if t <= 0 then fn() return end
		table.insert(threads, task.delay(t, function() if alive and model.Parent then fn() end end))
	end
	local function cycle()
		for _, b in BURSTS do
			local e = objects[b[1]]
			if e then at(b[2], function() e:Emit(b[3]) end) end
		end
		if options.onMarker then
			for _, m in MARKERS do at(m[1], function() options.onMarker(m[2], model) end) end
		end
	end
	local function setAll(on)
		for _, w in WINDOWS do
			local o = objects[w[1]]
			if o then o.Enabled = on end
		end
	end
	local function finish(delayTime)
		if not alive then return end
		alive = false
		if conn then conn:Disconnect() end
		for _, th in threads do pcall(task.cancel, th) end
		setAll(false)
		task.delay(delayTime, function() model:Destroy() end)
	end

	if #TRACKS > 0 then
		conn = RunService.Heartbeat:Connect(function()
			if not model.Parent then finish(0) return end
			local t = os.clock() - started
			if LOOP then t = t % DURATION end
			for _, tr in TRACKS do
				local o = objects[tr[1]]
				if o then o[tr[2]] = valueAt(tr[3], t) end
			end
		end)
	end
	if LOOP then
		setAll(true)
		table.insert(threads, task.spawn(function()
			while alive and model.Parent do cycle() task.wait(DURATION) end
		end))
	else
		for _, w in WINDOWS do
			local o = objects[w[1]]
			if o then
				at(w[2], function() o.Enabled = true end)
				at(w[3], function() o.Enabled = false end)
			end
		end
		cycle()
		task.delay(TAIL + 0.1, function() finish(0) end)
	end

	local handle = { Model = model }
	function handle:Stop() finish(MAX_LIFE + 0.1) end
	return handle
end

return VFX
]]></ProtectedString>
