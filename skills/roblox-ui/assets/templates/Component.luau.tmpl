--!strict
-- {{NAME}}: TODO one line on what it shows and where it is used.
--
--   e({{NAME}}, { title = "Daily quests", layoutOrder = 2 })
--
-- Pure view: everything it shows comes in through props, every change goes out through a
-- callback prop. Sizes from Tokens through ui.px, colours from ui.palette.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local React = require(ReplicatedStorage.Packages.React)
local Responsive = require(script.Parent.Parent.Foundation.Responsive)
local Stack = require(script.Parent.Parent.Primitives.Stack)
local Text = require(script.Parent.Parent.Primitives.Text)
local Tokens = require(script.Parent.Parent.Theme.Tokens)
local UiContext = require(script.Parent.Parent.Foundation.UiContext)

local e = React.createElement

export type Props = {
	title: string,
	layoutOrder: number?,
}

local function {{NAME}}(props: Props)
	local ui = UiContext.useUi()
	local padding = Responsive.pick(ui.sizeClass, { Compact = Tokens.Space.M, Expanded = Tokens.Space.L })

	return e(Stack, {
		size = UDim2.fromScale(1, 0),
		automaticSize = Enum.AutomaticSize.Y,
		gap = Tokens.Space.S,
		padding = padding,
		color = ui.palette.Surface,
		transparency = Tokens.Transparency.Surface,
		radius = Tokens.Radius.L,
		layoutOrder = props.layoutOrder,
	}, {
		Title = e(Text, { text = props.title, variant = "Heading", layoutOrder = 1 }),
	})
end

return {{NAME}}
